{
  "name": "uni-manager-shared",
  "version": "1.0.0",
  "description": "Shared utilities, components, and types for Uni-Manager applications",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./components": {
      "types": "./components/index.ts",
      "import": "./components/index.ts",
      "default": "./components/index.ts"
    },
    "./utils": {
      "types": "./utils/index.ts",
      "import": "./utils/index.ts",
      "default": "./utils/index.ts"
    },
    "./types": {
      "types": "./types/index.ts",
      "import": "./types/index.ts",
      "default": "./types/index.ts"
    },
    "./theme": {
      "types": "./theme/index.ts",
      "import": "./theme/index.ts",
      "default": "./theme/index.ts"
    },
    "./auth": {
      "types": "./auth/index.ts",
      "import": "./auth/index.ts",
      "default": "./auth/index.ts"
    },
    "./auth/*": {
      "types": "./auth/*.ts",
      "import": "./auth/*.ts",
      "default": "./auth/*.ts"
    },
    "./paypal": {
      "types": "./paypal/index.ts",
      "import": "./paypal/index.ts",
      "default": "./paypal/index.ts"
    },
    "./command": {
      "types": "./command/index.ts",
      "import": "./command/index.ts",
      "default": "./command/index.ts"
    },
    "./i18n": {
      "types": "./i18n/index.ts",
      "import": "./i18n/index.ts",
      "default": "./i18n/index.ts"
    },
    "./tailwind.preset": "./tailwind.preset.js"
  },
  "scripts": {
    "build": "echo 'Shared library build placeholder'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:once": "vitest run --reporter=verbose",
    "lint": "echo 'Shared library lint placeholder'",
    "lint:fix": "echo 'Shared library lint placeholder'"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.1.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "axios": "^1.9.0",
    "date-fns": "^4.1.0",
    "firebase": "^12.12.1",
    "i18next": "^26.0.8",
    "idb-keyval": "^6.2.2",
    "lerna": "9.0.3",
    "lucide-react": "^1.7.0",
    "react-i18next": "^17.0.6",
    "socket.io-client": "^4.8.3",
    "swagger-jsdoc": "6.2.8",
    "web-vitals": "^5.2.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.29"
  }
}
