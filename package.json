{
  "name": "uni-manager-shared",
  "version": "1.0.0",
  "description": "Shared utilities, components, and types for Uni-Manager applications",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./components": "./components/index.js",
    "./utils": "./utils/index.js",
    "./types": "./types/index.js",
    "./theme": "./theme/index.js",
    "./auth": "./auth/index.js",
    "./paypal": "./paypal/index.js",
    "./command": "./command/index.js",
    "./tailwind.preset": "./tailwind.preset.js"
  },
  "scripts": {
    "build": "echo 'Shared library build placeholder'",
