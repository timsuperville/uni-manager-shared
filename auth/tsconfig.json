{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noImplicitReturns": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts", "vite-env.d.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
